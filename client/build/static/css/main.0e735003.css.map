.container { min-height:100vh; display:flex; flex-direction:column; justify-content:center; align-items:center; position:relative; overflow:hidden; background:linear-gradient(130deg,rgba(8,20,45,.9),rgba(13,55,98,.66)),url('pokemon.png') center/cover; color:#fff; }

.title { z-index:1; margin-bottom:2rem; text-align:center; color:#fff; text-shadow:0 10px 35px rgba(0,0,0,.35); font-size:clamp(4rem,12vw,9rem); letter-spacing:-.08em; line-height:.9; font-weight:800; text-transform:uppercase; }

.title h1 {
    font-size: 5rem;
    font-weight: 800;
    text-transform: uppercase;
}

.linkList { z-index:1; display:flex; justify-content:center; align-items:center; }

.button { display:inline-flex; align-items:center; margin:.5rem; padding:1rem 1.75rem; border-radius:999px; background:#fff; color:#10233e; font-size:1rem; font-weight:700; text-transform:uppercase; text-decoration:none; box-shadow:0 15px 30px rgba(0,0,0,.25); transition:.25s ease; }

.button:hover { transform:translateY(-4px); background:#facc15; }

.copyright{
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index:1; text-align: center; color:rgba(255,255,255,.7); font-size:.8rem;
}

@media (max-width: 780px) {
    .container{
        max-width: fit-content;
        min-height: 100vh;
        border:5px solid black;
    }

    .title {
        font-size: 5.5rem;
    }

    .button {
        font-size: 2rem;
        padding: 1rem 2rem;
    }
}
